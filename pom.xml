<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq</groupId>
        <artifactId>vidocq-parent</artifactId>
        <version>0.4.0-RC1</version>
        <relativePath />
    </parent>

    <groupId>io.vidocq.peano</groupId>
    <artifactId>peano-parent</artifactId>
    <version>0.4.0-RC1</version>
    <packaging>pom</packaging>

    <name>Peano</name>
    <description>Jakarta Expression Language 6.0 implementation — zero third-party dependency, strict Java Modules, build-time accessor generation and compiled expressions instead of runtime reflection</description>
    <url>https://codefloe.com/Vidocq/peano</url>

    <developers>
        <developer>
            <name>Yann Blazart</name>
            <email>yann.blazart@gmail.com</email>
        </developer>
    </developers>

    
    <licenses>
        <license>
            <name>EPL-2.0</name>
            <url>https://www.eclipse.org/legal/epl-2.0/</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>EUPL-1.2</name>
            <url>https://joinup.ec.europa.eu/collection/eupl/eupl-text-eupl-12</url>
            <distribution>repo</distribution>
        </license>
        <license>
            <name>GPL-2.0-or-later</name>
            <url>https://www.gnu.org/licenses/old-licenses/gpl-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <url>https://codefloe.com/Vidocq/peano</url>
        <connection>scm:git:https://codefloe.com/Vidocq/peano.git</connection>
        <developerConnection>scm:git:git@codefloe.com:Vidocq/peano.git</developerConnection>
    </scm>

    <properties>
        
        <jakarta.el.version>6.0.1</jakarta.el.version>

        
        <sonar.coverage.jacoco.xmlReportPaths>${maven.multiModuleProjectDirectory}/peano-coverage/target/site/jacoco-aggregate/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
    </properties>

    
    <modules>
        <module>peano-api</module>
        <module>peano-core</module>
        <module>peano-processor</module>
        <module>peano-compiler</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>${jakarta.el.version}</version>
            </dependency>

            
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vidocq.peano</groupId>
                <artifactId>peano-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <profile>
            <id>bench</id>
            <modules><module>peano-bench</module></modules>
        </profile>
        <profile>
            <id>beans-compat</id>
            <modules>
                <module>peano-beans-compat</module>
            </modules>
        </profile>
        
        <profile>
            <id>tck</id>
            <modules>
                <module>peano-tck</module>
            </modules>
        </profile>
        
        <profile>
            <id>quality</id>
            <modules>
                <module>peano-coverage</module>
            </modules>
        </profile>
    </profiles>
</project>