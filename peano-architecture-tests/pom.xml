<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.vidocq.peano</groupId>
        <artifactId>peano-parent</artifactId>
        <version>0.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>peano-architecture-tests</artifactId>

    <name>Peano :: Architecture tests</name>
    <description>The architecture rules of Peano as tests, applied to the classes of every shipped module
        (Vidocq/vidocq#289)</description>

    <properties>
        <!-- Test-only module: never released, installed or deployed. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <maven.source.skip>true</maven.source.skip>
        <gpg.skip>true</gpg.skip>
    </properties>

    <!--
        Every dependency is test-scoped: the module ships nothing. The four modules of the default reactor are
        listed so that ArchUnit imports their classes. peano-beans-compat (the beans-compat profile) and the bench,
        TCK and coverage modules are not imported.
    -->
    <dependencies>
        <dependency>
            <groupId>io.vidocq.peano</groupId>
            <artifactId>peano-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.peano</groupId>
            <artifactId>peano-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.peano</groupId>
            <artifactId>peano-processor</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vidocq.peano</groupId>
            <artifactId>peano-compiler</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The architecture rules (Vidocq/vidocq#289): the shared vidocq-archrules library of
             vidocq-parent, test scope only, never shipped, next to JUnit (AGENTS.md). It brings ArchUnit's
             core (Apache-2.0, slf4j-api). -->
        <dependency>
            <groupId>io.vidocq</groupId>
            <artifactId>vidocq-archrules</artifactId>
            <version>0.4.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- maven.deploy.skip is not enough: central-publishing replaces maven-deploy-plugin. -->
            <plugin>
                <groupId>org.sonatype.central</groupId>
                <artifactId>central-publishing-maven-plugin</artifactId>
                <configuration>
                    <skipPublishing>true</skipPublishing>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
